---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, siteName } from '../site';
import { personLd, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects for this page */
  jsonLd?: object[];
  noindex?: boolean;
  /** Use the title as is, without the " | site name" suffix (home page). */
  rawTitle?: boolean;
}
const { title, description, jsonLd = [], noindex = false, rawTitle = false } = Astro.props;
const fullTitle = rawTitle || title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/og.png`, Astro.site).toString();
const ogImageAlt = `${SITE.name_he} - ${SITE.name_en}: ${SITE.tagline_he}. Python ו-C#, עם הסבר אחרי כל שאלה.`;
const isNoindex = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '';
// One graph for the whole site: every page points to the same Person and WebSite (by @id),
// so Google can connect "ידידיה פרידלנד" / "Yedidya Friedland" searches to this site.
const ld = [
  {
    '@context': 'https://schema.org',
    '@graph': [personLd(Astro.site), websiteLd(Astro.site)],
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="he" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {isNoindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta name="author" content={`${SITE.name_he} (${SITE.name_en})`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#1b2a41" />
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('yf.progress.v1') || '{}');
        var t = s && s.settings && s.settings.theme;
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">דילוג לתוכן</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {SITE.cfBeaconToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}></script>
    )}
    <style is:global>
      .skip { position: absolute; inset-inline-start: 8px; top: -60px; background: var(--primary); color: var(--on-primary); padding: 8px 12px; border-radius: 8px; z-index: 100; }
      .skip:focus { top: 8px; }
    </style>
  </body>
</html>
