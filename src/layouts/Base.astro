---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, siteName } from '../site';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects for this page */
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site).toString();
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: new URL(import.meta.env.BASE_URL, Astro.site).toString(),
    inLanguage: 'he',
    author: { '@type': 'Person', name: SITE.name_en, alternateName: SITE.name_he },
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={`${SITE.name_he} (${SITE.name_en})`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
    <meta name="theme-color" content="#2b55c9" />
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('yf.progress.v1') || '{}');
        var t = s && s.settings && s.settings.theme;
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">דילוג לתוכן</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {SITE.cfBeaconToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}></script>
    )}
    <style is:global>
      .skip { position: absolute; inset-inline-start: 8px; top: -60px; background: var(--primary); color: var(--on-primary); padding: 8px 12px; border-radius: 8px; z-index: 100; }
      .skip:focus { top: 8px; }
    </style>
  </body>
</html>
