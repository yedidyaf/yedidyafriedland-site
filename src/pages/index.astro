---
import Base from '../layouts/Base.astro';
import { getContent } from '../lib/content';
import { href } from '../lib/url';
import { siteName } from '../site';
import { bidi } from '../lib/text';
const langs = getContent();
const count = (l: (typeof langs)[number]) => l.chapters.reduce((n, c) => n + c.topics.reduce((m, t) => m + t.questions.length, 0), 0);
const total = langs.reduce((n, l) => n + count(l), 0);
const description = `לומדים Python ו-C# דרך מבחנים: ${total} שאלות עם הסבר מלא, מבחני סימולציה, קוד נקי, OOP וארכיטקטורה. בחינם, בלי הרשמה.`;
---
<Base title={`${siteName} | תרגול Python ו-C# דרך מבחנים`} rawTitle description={description}>
  <section class="home container">
    <p class="eyebrow">לימוד תכנות דרך מבחנים</p>
    <h1>
      באיזו שפה
      <span class="circled">מתרגלים?<svg viewBox="0 0 200 70" preserveAspectRatio="none" aria-hidden="true"><path d="M12 38 C 20 8, 180 4, 190 32 C 198 58, 30 66, 14 44 C 8 34, 40 20, 70 16" /></svg></span>
    </h1>
    <p class="lead">בחרו שפה, ואחר כך פרק. אחרי כל שאלה מופיע הסבר מלא.</p>

    <ul class="choices" aria-label="בחירת שפה">
      {langs.map((l, i) => (
        <li>
          <a class="lang-card" href={href(`/${l.id}/`)}>
            <span class="sheet-num" aria-hidden="true">טופס {i === 0 ? 'א׳' : 'ב׳'}</span>
            <span class="lang-name" dir="ltr">{l.title_en}</span>
            <span class="lang-he">{l.title_he}</span>
            <span class="lang-desc">{l.description_he}</span>
            <span class="lang-meta">{l.chapters.length} פרקים · {count(l)} שאלות</span>
            <span class="go">לבחירת פרק <span aria-hidden="true">←</span></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="muted small note">בחינם ובלי הרשמה. ההתקדמות נשמרת רק בדפדפן שלכם.</p>
  </section>
</Base>
<style>
  .home { padding-top: 56px; padding-bottom: 8px; text-align: center; }
  .home h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.15; margin-bottom: .35em; }
  .home .lead { color: var(--muted); margin: 0 auto 2em; max-width: 36em; }
  .circled { position: relative; display: inline-block; white-space: nowrap; }
  .circled svg { position: absolute; inset: -14px -20px -10px -20px; width: calc(100% + 40px); height: calc(100% + 24px); overflow: visible; }
  .circled path { fill: none; stroke: var(--pen); stroke-width: 3; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .choices { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 28px; max-width: 860px; }
  .lang-card {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%;
    padding: 40px 24px 28px; text-decoration: none; color: var(--text);
    background: var(--surface); border: 2px solid var(--text); box-shadow: var(--shadow-ink);
    transition: transform .12s, box-shadow .12s;
  }
  .lang-card:hover, .lang-card:focus-visible { transform: translate(-2px, -2px); }
  .lang-card:hover .go, .lang-card:focus-visible .go { color: var(--pen); }
  .sheet-num { position: absolute; top: 12px; inset-inline-start: 14px; font-weight: 700; font-size: .8rem; color: var(--pen); border: 1.5px solid var(--pen); padding: 2px 8px; transform: rotate(-5deg); }
  .lang-name { font-family: var(--mono); font-weight: 700; font-size: clamp(2.4rem, 7vw, 3.2rem); line-height: 1.1; }
  .lang-he { font-family: var(--serif); font-weight: 900; font-size: 1.3rem; }
  .lang-desc { color: var(--muted); font-size: .97rem; max-width: 26em; margin-top: 6px; }
  .lang-meta { font-size: .9rem; margin-top: 4px; border-top: 1px dashed var(--border); padding-top: 10px; }
  .go { margin-top: 14px; font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .note { margin-top: 28px; }
  @media (prefers-reduced-motion: reduce) { .lang-card { transition: none; } .lang-card:hover { transform: none; } }
</style>
