---
import Base from '../../layouts/Base.astro';
import { inline } from '../../lib/text';

const groups: { title: string; terms: [string, string, string][] }[] = [
  {
    title: 'יסודות - Basics',
    terms: [
      ['משתנה', 'Variable', 'שם שמצביע על ערך בזיכרון. בפייתון המשתנה הוא תווית לאובייקט, וב-C# יש לו טיפוס קבוע.'],
      ['טיפוס נתונים', 'Data Type', 'סוג הערך וקבוצת הפעולות המותרות עליו, למשל `int`, `str`, `bool`.'],
      ['המרת טיפוסים', 'Type Conversion / Casting', 'הפיכת ערך מטיפוס אחד לאחר, למשל `int("5")` או `(double)x`.'],
      ['אופרטור', 'Operator', 'סימן שמבצע פעולה על ערכים: חשבון, השוואה או לוגיקה.'],
      ['ביטוי', 'Expression', 'צירוף של ערכים ואופרטורים שמחושב לערך אחד.'],
      ['אובייקט בלתי ניתן לשינוי', 'Immutable', 'אובייקט שאי אפשר לשנות אחרי שנוצר, כמו מחרוזת. כל "שינוי" יוצר אובייקט חדש.'],
    ],
  },
  {
    title: 'זרימת בקרה - Control Flow',
    terms: [
      ['תנאי', 'Condition', 'ביטוי בוליאני שקובע איזה ענף של הקוד ירוץ (`if` / `else`).'],
      ['לולאה', 'Loop', 'חזרה על קטע קוד: `for` עוברת על אוסף, `while` רצה כל עוד תנאי מתקיים.'],
      ['איטרציה', 'Iteration', 'סיבוב אחד של לולאה, או המעבר על כל איברי אוסף.'],
      ['שגיאת סטייה באחד', 'Off-by-one Error', 'באג נפוץ שבו לולאה או טווח רצים פעם אחת יותר מדי או פעם אחת פחות מדי.'],
    ],
  },
  {
    title: 'פונקציות - Functions',
    terms: [
      ['פונקציה', 'Function', 'קטע קוד בעל שם שמקבל פרמטרים ומחזיר ערך. ב-C# כל פונקציה היא מתודה של מחלקה.'],
      ['פרמטר וארגומנט', 'Parameter / Argument', 'פרמטר הוא השם בהגדרת הפונקציה, וארגומנט הוא הערך שמעבירים בקריאה.'],
      ['טווח הכרה', 'Scope', 'האזור בקוד שבו שם של משתנה מוכר.'],
      ['רקורסיה', 'Recursion', 'פונקציה שקוראת לעצמה. חייב להיות לה מקרה בסיס שעוצר את הקריאות.'],
      ['ביטוי למבדא', 'Lambda Expression', 'פונקציה קצרה בלי שם, למשל `lambda x: x * 2` או `x => x * 2`.'],
      ['תופעת לוואי', 'Side Effect', 'שינוי שפונקציה עושה מחוץ לעצמה, כמו כתיבה למשתנה גלובלי או להדפסה.'],
    ],
  },
  {
    title: 'תכנות מונחה עצמים - OOP',
    terms: [
      ['מחלקה ומופע', 'Class / Instance', 'מחלקה היא התבנית, ומופע (אובייקט) הוא עותק שנוצר ממנה.'],
      ['כימוס', 'Encapsulation', 'הסתרת המצב הפנימי של אובייקט וחשיפת פעולות מוגדרות בלבד.'],
      ['ירושה', 'Inheritance', 'יחס "הוא סוג של" (is-a): מחלקה יורשת התנהגות ממחלקת בסיס.'],
      ['הרכבה', 'Composition', 'יחס "יש לו" (has-a): אובייקט מחזיק אובייקטים אחרים כחלקים שלו.'],
      ['פולימורפיזם', 'Polymorphism', 'אותה קריאה מתנהגת אחרת לפי הטיפוס בפועל של האובייקט.'],
      ['ממשק', 'Interface', 'חוזה של מתודות בלי מימוש. מחלקה שמממשת אותו מתחייבת לספק אותן.'],
      ['מחלקה מופשטת', 'Abstract Class', 'מחלקה שאי אפשר ליצור ממנה מופע, ומשמשת בסיס למחלקות אחרות.'],
      ['דריסה', 'Override', 'מימוש מחדש של מתודה שהוגדרה במחלקת הבסיס.'],
    ],
  },
  {
    title: 'חריגות - Exceptions',
    terms: [
      ['חריגה', 'Exception', 'אירוע שגיאה שעוצר את הזרימה הרגילה עד שמישהו תופס אותו.'],
      ['תפיסת חריגה', 'try / except / catch', 'עטיפת קוד כדי לטפל בשגיאות צפויות במקום שהתוכנית תקרוס.'],
      ['ניהול משאבים', 'Context Manager / using', 'מנגנון שמבטיח שחרור משאב (קובץ, חיבור) גם כשנזרקת חריגה.'],
    ],
  },
  {
    title: 'קוד נקי - Clean Code',
    terms: [
      ['ריח קוד', 'Code Smell', 'סימן בקוד שמרמז על בעיית תכנון, גם אם הקוד עובד.'],
      ['מספר קסם', 'Magic Number', 'מספר בלי שם בתוך הקוד. עדיף קבוע עם שם שמסביר את משמעותו.'],
      ['שכפול קוד', 'Duplicated Code', 'אותה לוגיקה כתובה בכמה מקומות. שינוי עתידי יחייב לתקן בכולם.'],
      ['עקרון האחריות היחידה', 'Single Responsibility Principle', 'לכל מחלקה או פונקציה צריכה להיות סיבה אחת בלבד להשתנות.'],
      ['DRY', "Don't Repeat Yourself", 'כל ידע במערכת צריך להופיע במקום אחד בלבד.'],
      ['שינוי מבנה', 'Refactoring', 'שיפור מבנה הקוד בלי לשנות את ההתנהגות שלו.'],
    ],
  },
  {
    title: 'תכנון תוכנה - Software Design',
    terms: [
      ['ארכיטקטורת שכבות', 'Layered Architecture', 'חלוקה לשכבות: ממשק משתמש, לוגיקה עסקית וגישה לנתונים. כל שכבה תלויה רק בשכבה שמתחתיה.'],
      ['מאגר', 'Repository', 'רכיב שאחראי לשמירה ולשליפה של נתונים, ומסתיר את מסד הנתונים מהשאר.'],
      ['שכבת שירות', 'Service Layer', 'המקום של הלוגיקה העסקית: כללים, חישובים ותיאום בין רכיבים.'],
      ['הזרקת תלויות', 'Dependency Injection', 'העברת התלויות של מחלקה מבחוץ (בדרך כלל בבנאי) במקום ליצור אותן בתוכה.'],
      ['צימוד', 'Coupling', 'מידת התלות בין רכיבים. צימוד נמוך מקל על שינוי ובדיקה.'],
      ['לכידות', 'Cohesion', 'מידת הקשר בין האחריויות בתוך רכיב אחד. לכידות גבוהה היא סימן לתכנון טוב.'],
      ['תבנית עיצוב', 'Design Pattern', 'פתרון מוכר לבעיה חוזרת, כמו Strategy, Factory או Observer.'],
    ],
  },
];
---
<Base title="מילון מונחים - Glossary" description="מילון מונחי תכנות בעברית ובאנגלית: OOP, קוד נקי, ארכיטקטורה, פונקציות וחריגות, עם הסבר קצר לכל מונח.">
  <div class="container prose">
    <h1 style="margin-top:24px">מילון מונחים - Glossary</h1>
    <p class="lead muted">המונחים שמופיעים בשאלות ובהסברים, בעברית ובאנגלית.</p>
    {groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <dl class="glossary">
          {g.terms.map(([he, en, def]) => (
            <>
              <dt>{he} <span class="en">- <span dir="ltr">{en}</span></span></dt>
              <dd set:html={inline(def)} />
            </>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Base>
