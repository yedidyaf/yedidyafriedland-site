---
import Base from '../../../layouts/Base.astro';
import { getContent } from '../../../lib/content';
import { href } from '../../../lib/url';
import { bilingual, bidi } from '../../../lib/text';
import Bi from '../../../components/Bi.astro';

export function getStaticPaths() {
  return getContent().flatMap((l) => l.chapters.map((c) => ({ params: { lang: l.id, chapter: c.id } })));
}
const lang = getContent().find((l) => l.id === Astro.params.lang)!;
const chapter = lang.chapters.find((c) => c.id === Astro.params.chapter)!;
const n = chapter.topics.reduce((m, t) => m + t.questions.length, 0);
const title = `${bilingual(chapter.title_he, chapter.title_en)} | ${lang.title_en}`;
---
<Base title={title} description={`${chapter.description_he} ${n} שאלות תרגול ב${lang.title_he} עם הסברים.`}>
  <div class="container ruled">
    <nav class="breadcrumbs" aria-label="פירורי לחם">
      <a href={href('/')}>בית</a> / <a href={href(`/${lang.id}/`)}>{lang.title_he}</a> / <span>{chapter.title_he}</span>
    </nav>
    <h1>{bilingual(chapter.title_he, chapter.title_en)}</h1>
    <p class="lead muted">{bidi(chapter.description_he)}</p>
    <div class="row-actions ch-actions">
      <a class="btn ruled-btn" href={href(`/exam/?lang=${lang.id}&mode=chapter&chapter=${chapter.id}`)}>מבחן על כל הפרק (15 שאלות)</a>
      <a class="btn secondary ruled-btn" href={href(`/${lang.id}/new/?ch=${chapter.id}`)}>מבחן מותאם</a>
    </div>
    <ol class="toc ruled-toc">
      {chapter.topics.map((t, i) => (
        <li>
          <div class="toc-head">
            <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
            <h2><a href={href(`/${lang.id}/${chapter.id}/${t.id}/`)}><Bi he={t.title_he} en={t.title_en} /></a></h2>
          </div>
          <p class="toc-desc muted">{bidi(t.summary_he)}</p>
          <div class="toc-row">
            <a class="btn sm" href={href(`/exam/?lang=${lang.id}&mode=topic&chapter=${chapter.id}&topic=${t.id}`)}>לתרגל</a>
            <span class="lvl none" data-topic={`${lang.id}/${chapter.id}/${t.id}`}>לא התחלתם</span>
            <span class="muted small">{t.questions.length} שאלות</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>
<script>
  import { load } from '../../../lib/storage';
  import { level, mastery, LEVEL_LABEL } from '../../../lib/scoring';
  const s = load();
  document.querySelectorAll<HTMLElement>('[data-topic]').forEach((el) => {
    const r = s.topics[el.dataset.topic!];
    const lv = level(r);
    const m = mastery(r ?? []);
    el.className = `lvl ${lv}`;
    el.textContent = LEVEL_LABEL[lv] + (m !== null ? ` ${m}%` : '');
  });
</script>
<style>
  /* written on the ruled lines like the language page (see .ruled in global.css) */
  .ch-actions { gap: var(--ln) 10px; margin-top: var(--ln); }
  .ruled-toc { margin-top: var(--ln); }
  .ruled-toc > li { padding: 0 0 var(--ln); border: 0; box-shadow: inset 0 -1px 0 var(--border); }
  .ruled-toc > li:first-child { border: 0; box-shadow: inset 0 2px 0 var(--text), inset 0 -1px 0 var(--border); }
  .ruled-toc .toc-head h2 { line-height: var(--ln); }
  .ruled-toc .toc-head { align-items: start; }
  .ruled-toc .toc-num { line-height: var(--ln); }
  .ruled-toc .toc-desc { margin: 0; }
  .ruled-toc .toc-row { margin-top: 0; gap: var(--ln) 14px; line-height: var(--ln); }
  @media (max-width: 600px) { .ruled-toc .toc-head h2 { font-size: 1.15rem; } }
</style>
